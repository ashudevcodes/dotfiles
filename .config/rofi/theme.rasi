* {
    background-color:   transparent;
    text-color:         @fg0;

    bg0:    #242424E6;
    bg1:    #7E7E7E80;
    bg2:    #0860f2E6;

    fg0:    #DEDEDE;
    fg1:    #FFFFFF;
    fg2:    #DEDEDE80;
    bg3:    #1A73E8F2;
    fg3:    #3D3D3D;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    border-radius:      7px;
    location:           center;
    transparency:       "real";
    width:              480;
    background-color:   #00000080;
}

mainbox {
    padding:    25px;
}

inputbar {
    background-color:   @bg0;
    border-radius:      16px;
    border-color:       @fg3;
    border:             3;


    padding:            8px 16px;
    spacing:            10px;
    children:           [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}


message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    scrollbar:          false;
    margin:             12px 0 0;
    spacing:            10; 
    lines:              6;
    columns:            1;

    fixed-height:       false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected.normal, element selected.active {
    background-color:   @bg1;
}
element-icon {
    background-color: transparent;
    size:             1.0000em ;
    cursor:           inherit;
    text-color:       inherit;
}

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}
