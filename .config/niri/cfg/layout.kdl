layout {

    always-center-single-column
    background-color "rgb(0,0,0)"


    focus-ring {
		on
        width 2
        inactive-color "#00000014"
		active-color "rgb(39,39,39)"
    }

    struts {
        right 8
        top 8
        bottom 8
    }

    gaps 12
    border {
        off
    }
}

window-rule {
    geometry-corner-radius 17 17 8 8

    clip-to-geometry true

    shadow {
	  on
	  softness 20
	  spread 1
	  offset x=0 y=2
	  draw-behind-window true
	  color "rgba(0,0,0,0.790)"
	  inactive-color "rgba(0,0,0,0.790)"
    }

    background-effect {
        xray true
    }
}


recent-windows {
    open-delay-ms 0

	highlight {
	  padding 10
	  corner-radius 10
	}
}
