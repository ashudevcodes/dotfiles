layout {
  gaps 10
  //center-focused-column "never"

  //default-column-display "tabbed"
  background-color "transparent"

  insert-hint {
	color "#ffc87f80"
	gradient from="#ffbb6680" to="#ffc88080" angle=45 relative-to="workspace-view"
  }

  focus-ring {
	width 2
	//active-color "rgba(80, 80, 80, 0.8)"
	//active-color "#ffffff30"
	active-gradient from="rgba(80, 80, 80, 0.7)" to="rgba(80, 80, 80, 0.3)" angle=180 relative-to="workspace-view"
  }
  shadow {
	on
	//softness 1
	//spread 3
	//color "#00000090"

	//inactive-color "transparent"
  }
}
