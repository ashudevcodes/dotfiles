window-rule {
  match app-id="xdg-desktop-portal-gtk"

  default-column-width { proportion 0.6; }
  default-window-height { proportion 0.6; }

  opacity 0.9

  background-effect {
	blur true
	xray false
    }
}

window-rule {
  match app-id="localsend"
  open-floating true
}

window-rule {
  match app-id="foot-float"
  open-floating true

  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.7; }

  shadow {
        on
	 color "#00000090"

    }

  background-effect {
	blur false
	xray true
	//saturation 0
    }
}

window-rule {
  match app-id="org.pulseaudio.pavucontrol"
  open-floating true
  opacity 0.9

  default-column-width { proportion 0.5; }
  default-window-height { proportion 0.5; }

  popups {
	background-effect {
	  blur true
	  xray false
        }
    }

  background-effect {
    blur true
    xray false
    }
}

window-rule {
  match app-id="nvidia-settings"
  open-floating true
  opacity 0.9

  default-column-width { proportion 0.6; }
  default-window-height { proportion 0.6; }

  popups {
	background-effect {
	  blur true
	  xray false
        }
    }

  background-effect {
    blur true
    xray false
    }
}

window-rule {
  match app-id="org.kde.dolphin"
  open-floating true
  opacity 0.9

  default-column-width { proportion 0.6; }
  default-window-height { proportion 0.6; }

  popups {
	background-effect {
	  blur true
	  xray false
        }
    }

  background-effect {
    blur true
    xray false
    }
}

window-rule {
  match app-id="Waydroid"
  open-fullscreen true
}

window-rule {
  match app-id="mpv"
  open-floating true
  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.7; }
}
