window-rule {
  geometry-corner-radius 17
  clip-to-geometry true
  tiled-state true
  draw-border-with-background false
}

layer-rule {
  match namespace="rofi"
  geometry-corner-radius 20
  background-effect {
	blur true
	xray false
	saturation 2
  }
}

window-rule {
  match app-id="footclient"
  background-effect {
	blur true
	xray true
	saturation 2
  }
}

layer-rule {
  match layer="background"
  place-within-backdrop true
}

layer-rule {
  match namespace="waybar"

  geometry-corner-radius 20
  background-effect {
	blur true
	xray false
	saturation 2
  }
}

