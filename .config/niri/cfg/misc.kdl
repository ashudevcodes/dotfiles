prefer-no-csd

cursor {
  xcursor-theme "material_light_cursors"
  //xcursor-size 24

  hide-when-typing
  hide-after-inactive-ms 1000
}

environment {
    DISPLAY ":0"
	GTK_ICON_THEME_NAME "oxygen"
	QT_QPA_PLATFORMTHEME "qt6ct"

}

hotkey-overlay {
  skip-at-startup
}

xwayland-satellite {
    off
}

overview {
    zoom 1
    backdrop-color "transparent"

    workspace-shadow {
        off
        //softness 24
        //spread 12
        //offset x=0 y=0
        //color "#00000090"
    }
}
output "eDP-1" {
    //mode "1920x1080@60.000"
    //scale 1.1
    //position x=0 y=0
    variable-refresh-rate on-demand=true
    focus-at-startup
}

switch-events {
   lid-close { spawn "hyprlock" "-q"; }
}
