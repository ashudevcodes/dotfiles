{
  "layer": "top",
  "position": "left",
  "margin-left" : 10,
  "height" : 900,
  "width" : 75,
  "exclusive": true,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left":[
	"custom/launcher",
	"cffi/liquid_battery",
	"niri/workspaces"
  ],

  "modules-center":[
	"bluetooth"
  ],

  "modules-right": [
	"backlight",
    "custom/separator",
	"wireplumber",
	"clock"
  ],

  "backlight":{
	"format": "{icon}",
	"format-icons":[""],
	"tooltip": false,
	"reverse-scrolling" : true
  },

  "custom/separator": {
	"format": "󰇙",
	"rotate" : 270,
	"tooltip": false
  },

  "custom/launcher": {
	"format": "{icon}",
	"format-icons": "",
	"tooltip": false
  },

  "niri/workspaces": {
	"format": "{icon}",
	"format-icons": {
	  "active" : "󰮯",
	  "default" : "󱙝"
	},
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
  },

  "clock": {
	"format": "{:%H\n%M\n---\n%d\n%m}",
	"tooltip": false,
	"interval": 60
  },

  "wireplumber": {
	"format": "{icon}",
	"format-muted": "",
	"reverse-scrolling" : true,
	"format-icons": { "default": ["󰕿","󰖀","󰕾"] },
	"on-click": "pavucontrol",
	"tooltip": false,
	"rotate" : 90,
	"scroll-step": 1
  },

  "bluetooth": {
	"format": "",
	"format-connected": "{device_alias}",
	"rotate" : 90,
	"format-disabled": "",
	"on-click": "footclient -e bluetoothctl",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },

  "cffi/liquid_battery": {
	"module_path": "/home/nemo/.local/lib/waybar/modules/libliquid-battery.so"
  }
}


