{
  "layer": "top",
  "position": "left",
  "margin-left" : 10,
  "height" : 1020,
  "width" : 75,
  "exclusive": true,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left":[
	"custom/launcher",
	"custom/separator",
	"niri/workspaces"
  ],

  "modules-center":[
	"bluetooth"
  ],

  "modules-right": [
	"backlight",
	"custom/separator",
	"wireplumber",
	//"cffi/battery"
	"clock"
  ],

  "backlight":{
	"format": "",
	"tooltip": false,
	"reverse-scrolling" : true
  },
  "custom/separator": {
	"format": "󰇙",
	"rotate" : 270,
	"tooltip": false
  },

  "custom/launcher": {
	"format": "{icon}",
	"format-icons": "",
	"tooltip": false
  },

  "niri/workspaces": {
	"format": "{icon}",
	"format-icons": {
	  "active" : "󰮯",
	  "default" : "󰊠"
	},
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
  },

  "clock": {
	"format": "{:%H\n%M\n--\n%d\n%m}",
	"tooltip": false
  },

  "wireplumber": {
	"format": "{icon}",
	"format-muted": "",
	"reverse-scrolling" : true,
	"format-icons": { "default": ["󰕿","󰖀","󰕾"] },
	"on-click": "pavucontrol",
	"tooltip": false,
	"rotate" : 90,
	"scroll-step": 1
  },

  "bluetooth": {
	"format": "󰂯",
	"format-connected": "{device_alias}",
	"rotate" : 90,
	"format-disabled": "",
	"on-click": "footclient -e bluetoothctl"
  },

  "cffi/battery": {
	"module_path": "/home/nemo/.config/waybar/foo/wb_battery.so"
  }
}


