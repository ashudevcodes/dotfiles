{
  "layer": "top",
  "position": "left",
  "margin-left" : 10,
  "height" : 900,
  "width" : 72,
  "exclusive": true,
  "spacing": 0,
  "expand-center": true,
  "reload_style_on_change": true,

  "modules-left":[
	"group/power",
	"custom/separator",
	"niri/workspaces",
	"cffi/liquid_battery"
  ],

  "modules-center":[
	"bluetooth",
	"network"
  ],

  "modules-right": [
	"backlight",
	"custom/separator",
	"pulseaudio#output",
	"custom/separator",
	"cffi/touchpad",
	"custom/separator",
	"clock"
  ],

  "group/power": {
	"orientation": "inherit",
	"drawer": {
	  "transition-duration": 500,
	  "children-class": "not-power",
	  "transition-right-to-left": false
	},
	"modules": [
	  "custom/power",
	  "custom/quit",
	  "custom/lock",
	  "custom/reboot"
	]
  },

  "mpris": {
	"format": "{player_icon}",
	"format-paused": "{status_icon}",
	"player-icons": {
	  "default": "▶"
	},
	"status-icons": {
	  "paused": "⏸"
	}
  },

  "backlight":{
	"format": "{icon}",
	"format-icons":[""],
	"tooltip": false,
	"cursor": 42,
	"reverse-scrolling" : true
  },

  "custom/separator": {
	"format": "󰇙",
	"rotate" : 270,
	"tooltip": false
  },

  "custom/power": {
	"format" : "󰻀",
	"cursor": true,
	"tooltip": false
  },

  "custom/quit": {
	"format" : "󰩈",
	"cursor": true,
	"tooltip": true,
	"on-click": "poweroff",
	"tooltip-format": "<span>Shutdown :)</span>"
  },

  "custom/lock": {
	"format" : "󰷛",
	"tooltip": true,
	"on-click": "hyprlock -q",
	"tooltip-format": "<span>Lock</span>"
  },

  "custom/reboot": {
	"format" : "",
	"cursor": true,
	"tooltip": true,
	"on-click": "reboot",
	"tooltip-format": "<span>Reboot</span>"
  },

  "cffi/touchpad":{
	"module_path": "/home/nemo/.local/lib/waybar/modules/touchpad.so",
	"signal": 10
  },

  "niri/workspaces": {
	"format": "{icon}",
	"expend": true,
	"format-icons": {
	  "active" : "󰮯",
	  "default" : "󱙝"
	},
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
  },


  "clock": {
	"format":"󰸗",
	"tooltip-format": "<span font='JetBrainsMono' >{calendar}</span>",
	"calendar": {
	  "mode"          : "month",
	  "mode-mon-col"  : 3,
	  "format": {
		"months":     "<span color='#ffead3'><b>{}</b></span>",
		"days":       "<span color='#ecc6d9'><b>{}</b></span>",
		"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
		"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
		"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
	  }
	},
	"actions":  {
	  "on-click-right": "mode"
	},
	"interval": 60
  },


  "pulseaudio#output": {
	"format": "{icon}",
	"cursor": 42,
	"format-icons": {
	  "default": [ "", "", "" ],
	  "default-muted": ""
	},

	"format-muted": "",
	"reverse-scrolling" : true,
	"on-click": "pavucontrol",
	"rotate" : 90,
	"justify": "center",
	"tooltip": false,
	"scroll-step": 1
  },

  "bluetooth": {
	"format": "",
	"format-connected": "{device_alias}",
	"rotate" : 90,
	"format-disabled": "",
	"on-click": "footclient -e bluetoothctl",
	"on-click-right": "sh -c 'rfkill toggle bluetooth'",
	"tooltip-format-connected": "	Battery {device_battery_percentage}% "
  },

  "cffi/liquid_battery": {
	"module_path": "/home/nemo/.local/lib/waybar/modules/libliquid-battery.so",
	"cursor": false,
	"signal": 10
  },

  "network": {
    "interface": "wlan0",
    "format": "{icon}",
	"format-icons": ["󰤯","󰤢","󰤥","󰤨"],
    "format-disabled": "",
	"on-click": "footclient -e iwctl",
	"on-click-right": "sh -c 'rfkill toggle wlan'",
    "tooltip-format-wifi": "{essid} Signal    {signalStrength}% ",
    "max-length": 50
}
}


