{
  "layer": "top",
  "position": "left",
  "margin-left" : 10,
  "height" : 900,
  "width" : 72,
  "exclusive": true,
  "spacing": 0,
  "expand-center": true,
  "reload_style_on_change": true,

  "modules-left":[
	"custom/power",
	//"cffi/liquid_battery",
	"custom/separator",
	"niri/workspaces"
  ],

  "modules-center":[
	"bluetooth",
	"network"
  ],

  "modules-right": [
	"backlight",
	"custom/separator",
	"pulseaudio#output",
	"custom/separator",
	"cffi/touchpad",
	"custom/separator",
	"clock"
  ],

  "backlight":{
	"format": "{icon}",
	"format-icons":[""],
	"tooltip": false,
	"reverse-scrolling" : true
  },

  "custom/separator": {
	"format": "󰇙",
	"rotate" : 270,
	"tooltip": false
  },

  "custom/power": {
	"format" : "",
	"tooltip": false,
	"on-click": "sh -c ~/.config/waybar/powermenu.sh"
  },

  "custom/launcher": {
	"format": "{icon}",
	"format-icons": "",
	"tooltip": false
  },

  "cffi/touchpad":{
	"module_path": "/home/nemo/.local/lib/waybar/modules/touchpad.so",
	"signal": 10
  },

  "niri/workspaces": {
	"format": "{icon}",
	"format-icons": {
	  "active" : "󰮯",
	  "default" : "󱙝"
	},
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
  },

  "clock": {
	"format": "{:%H\n%M\n---\n%d\n%m}",
	"tooltip": false,
	"interval": 60
  },

  "pulseaudio#output": {
	"format": "{icon}",
	"format-icons": {
	  "default": [ "󰕿", "󰖀", "󰕾" ],
	  "default-muted": "󰝟"
	},


    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "cursor": true
    },

    "backlight/slider": {
        "min": 5,
        "max": 100,
        "cursor": true
    },

	"format-muted": "",
	"reverse-scrolling" : true,
	"on-click": "pavucontrol",
	"tooltip": false,
	"rotate" : 90,
	"scroll-step": 1
  },

  "bluetooth": {
	"format": "",
	"format-connected": "{device_alias}",
	"rotate" : 90,
	"format-disabled": "",
	"on-click": "footclient -e bluetoothctl",
	"on-click-right": "sh -c 'rfkill toggle bluetooth'",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },

  "cffi/liquid_battery": {
	"module_path": "/home/nemo/.local/lib/waybar/modules/libliquid-battery.so",
	"signal": 10
  },

  "network": {
    "interface": "wlan0",
    "format": "{icon}",
	"format-icons": ["󰤯","󰤢","󰤥","󰤨"],
    "format-disabled": "",
	"on-click": "footclient -e iwctl",
	"on-click-right": "sh -c 'rfkill toggle wlan'",
	"tooltip": false,
    "max-length": 50
}
}


