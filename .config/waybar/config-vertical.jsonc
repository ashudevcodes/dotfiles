{
  "layer": "bottom",
  "position": "bottom",
  "margin-bottom" : 10,
  "height" : 65,
  "width" : 2,
  "exclusive": false,
  "spacing": 4,
  "expand-center": true,
  "reload_style_on_change": true,

  "modules-left":[
  ],

  "modules-center":[
	"custom/rofi",
	"bluetooth",
	"network",
	"pulseaudio#output",
	"backlight",
	"hyprland/workspaces",
	"clock",
	"cffi/liquid_battery",
	"group/power"
  ],

  "modules-right": [
  ],

  "group/power": {
	"orientation": "inherit",
	"drawer": {
	  "transition-duration": 500,
	  "children-class": "not-power",
	  "transition-left-to-rigt": false
	},
	"modules": [
	  "custom/power",
	  "custom/quit",
	  "custom/lock",
	  "custom/reboot"
	]
  },

  "backlight":{
	"format": "{icon}",
	"format-icons":["candle","table_lamp", "light_group_2"],
	"tooltip-format": "{percent}% Brightness",
	"cursor": 42,
	"reverse-scrolling" : true
  },

  "custom/separator": {
	"format": "󰇙",
	"rotate" : 270,
	"tooltip": false
  },

  "custom/power": {
	"format" : "󰻀",
	"tooltip": false,
	"cursor": true
  },

  "custom/rofi": {
	"format" : "󱙇",
	"cursor": true,
	"tooltip-format": "<span>Search :)</span>",
	"on-click": "rofi -show drun"
  },

  "custom/quit": {
	"format" : "󰩈",
	"cursor": true,
	"tooltip": true,
	"on-click": "poweroff",
	"tooltip-format": "<span>Shutdown :)</span>"
  },

  "custom/lock": {
	"format" : "󰷛",
	"tooltip": true,
	"on-click": "hyprlock -q",
	"tooltip-format": "<span>Lock</span>"
  },

  "custom/reboot": {
	"format" : "",
	"cursor": true,
	"tooltip": true,
	"on-click": "reboot",
	"tooltip-format": "<span>Reboot</span>"
  },

  "cffi/touchpad":{
	"module_path": "/home/nemo/.local/lib/waybar/modules/touchpad.so",
	"signal": 10
  },

  "hyprland/workspaces": {
	"format": "{icon}",
	"expend": true,
	"format-icons": {
	  "active" : "ඞ",
	  "default" : "󱙝"
	},
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
  },

  "niri/workspaces": {
	"format": "{icon}",
	"expend": true,
	"format-icons": {
	  "active" : "ඞ",
	  "default" : "󱙝"
	},
	"on-scroll-up": "niri msg action focus-workspace-up",
	"on-scroll-down": "niri msg action focus-workspace-down"
  },


  "clock": {
	"format":"today",
	"tooltip-format": "<span font='JetBrainsMono' >{calendar}</span>",
	"calendar": {
	  "mode"          : "month",
	  "mode-mon-col"  : 3,
	  "format": {
		"months":     "<span color='#ffead3'><b>{}</b></span>",
		"days":       "<span color='#ecc6d9'><b>{}</b></span>",
		"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
		"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
		"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
	  }
	},
	"actions":  {
	  "on-click-right": "mode"
	},
	"interval": 60
  },


  "pulseaudio#output": {
	"on-update": "~/.local/bin/mute-led-toggle.sh",
	"format": "{icon}",
	//"scroll-scale": "db",
	//"scroll-step": 2.5,
	"cursor": 42,
	//"format-bluetooth":"earbuds_2",
	//"format-icons": [ "volume_down", "brand_awareness", "volume_up" ],

	"format-icons": {
	  "headset": "earbuds_2",
	  "default": [ "volume_down", "brand_awareness", "volume_up" ]
	},
	"format-muted": "volume_off",
	"reverse-scrolling" : true,
	"on-click": "pavucontrol",
	"tooltip-format": "{volume}%   "
  },

  "bluetooth": {
	"format": "bluetooth_searching",
	"format-connected": "{device_alias}",
	"format-disabled": "",
	//"rotate":90,
	"on-click": "footclient -e bluetoothctl",
	"on-click-right": "sh -c 'rfkill toggle bluetooth'",
	"tooltip-format-connected": "   Battery  {device_battery_percentage}% "
  },

  "cffi/liquid_battery": {
	"module_path": "/home/nemo/.local/lib/waybar/modules/libliquid-battery.so",
	"signal": 10
  },

  "network": {
    "interface": "wlan0",
    "format": "{icon}",
	"format-icons": ["network_wifi_1_bar","network_wifi_3_bar","network_wifi","signal_wifi_4_bar"],
	"format-disconnected": "perm_scan_wifi",
    "format-disabled": "",
	"on-click": "footclient -e iwctl",
	"on-click-right": "sh -c 'rfkill toggle wlan'",
    "tooltip-format-wifi": "{essid} Signal    {signalStrength}% ",
    "max-length": 50
}
}


