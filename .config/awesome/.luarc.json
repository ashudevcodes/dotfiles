{
    "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
    "description": "Awesomewm setting of sumneko.lua",
    "diagnostics": {
        "enable": true,
        "globals": [
            "awesome",
            "awful",
            "client",
            "screen",
            "tag",
            "update_timer",
            "root",
            "lgi",
            "Gio",
            "GLib"
        ]
    },
    "workspace": {
        "library": [
            "/usr/share/awesome/lib/",
            "/usr/share/lua/5.4/lgi/",
            "/usr/lib/lua/5.4/lgi/",
            "${workspace}/libs/",
            "${workspace}/wibgets/",
            "${workspace}/ui/",
            "${workspace}/programms/",
            "${workspace}/rules/",
            "${workspace}/signals/"
        ],
        "maxPreload": 2000,
        "preloadFileSize": 1000
    },
    "telemetry.enable": false,
    "hint.enable": true
}
