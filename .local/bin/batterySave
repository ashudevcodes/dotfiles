#!/bin/bash

set -xe 

HOUR=$(date +%H)

if ! command -v acpi >/dev/null 2>&1; then
  echo "acpi not found" >&2
  exit 1
fi

PICOM_BIN="$HOME/.config/picom/picom/src/picom"

if [[ $1 == "o" ]]; then

  if [[ ! $(killall picom) ]]; then
	$PICOM_BIN --daemon --config $HOME/.config/picom/picom-battery.conf
  fi
  ~/.local/bin/clsCaches

else 

  if acpi | grep "Discharging"; then
	echo "Running on DC power, adjusting settings..."
	brightnessctl set 0
	xrandr -r 60

	if [ "$XDG_SESSION_TYPE" != "tty" ]; then
	  ~/.config/picom/picom-toggle.sh
	fi

	sudo powertop --auto-tune

	if [ "$HOUR" -ge 20 ] && [ "$HOUR" -lt 23 ]; then
	  redshift -O 3500k
	  rfkill block wifi bluetooth
	fi

	~/.local/bin/clsCaches
	acpi

  else
	echo "Running on AC power."
	xrandr -r 144
  fi

fi


