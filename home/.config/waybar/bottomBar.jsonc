[{
	"id": "bottom_bar",
	"name": "bottom_bar",
	"include": ["~/.config/waybar/bottom_bar_modules.jsonc"],
	"layer": "bottom",
	"position": "bottom",
	"margin-bottom": 8,
	"height": 60,
	"width": 2,
	"exclusive": false,
	"spacing": 8,
	"expand-center": true,
	"reload_style_on_change": true,

	"modules-center": [
	  "custom/rofi",
	  "pulseaudio#output",
	  "bluetooth",
	  "network",
	  "backlight",
	  "clock",
	  "hyprland/workspaces",
	  "cffi/liquid_battery",
	  "group/power"
	]
}]
