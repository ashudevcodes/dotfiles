[{
	"id": "bottom_bar",
	"name": "bottom_bar",
	"include": ["~/.config/waybar/bottom_bar_modules.jsonc"],
	"layer": "bottom",
	"position": "bottom",
	"height": 60,
	"exclusive": false,
	"spacing": 8,
	"reload_style_on_change": true,
	"blur": true,


	"modules-center": [
	  "hyprland/workspaces"
	]

},
{	"id": "bottom_bar",
	"name": "bottom_bar",
	"include": ["~/.config/waybar/bottom_bar_modules.jsonc"],
	"layer": "bottom",
	"position": "top",
	"height": 60,
	"exclusive": false,
	"spacing": 8,
	"reload_style_on_change": true,
	"blur": true,

	"modules-right": [
	  "pulseaudio#output",
	  "network",
	  "backlight",
