@import "~/.cache/wallust/generated/rofi.rasi"

configuration {
  scroll-method: 0;
  drun-display-format: "<b>{name}</b>\n<span alpha='55%' weight='Semibold' size='small'><i>{comment}</i></span>";
}

entry {
  placeholder: " 󰥗\tSearch applications…";
  placeholder-color: @text-muted;
  padding: 12px 0px 0px 10px;
  text-color: @text-color;
  font: "AdwaitaSans 9";

  border: 1px;
  border-radius: 10px;
  background-color: @background;
  border-color: transparent;
}

mode-switcher {
  enabled: true;
  spacing: 10px;
  padding: 0px 8px;
}

button {
  padding: 0px 12px;
  border-radius: 13px;
  text-color: @text-muted;
  background-color: @background;
  border-color: @surface;
  font: "Material Symbols Rounded 15";
}

button selected {
  text-color: @text-color;
  background-color: @surface;
  border: 0px;
}

inputbar {
  border-radius: 1em;

  padding: 0.5em 0.3em;
  border: 0px;
  border-color: @outline;

  children:  [mode-switcher, entry, icon-current-entry];
  //children:  [mode-switcher, entry, textbox-current-entry];
}

textbox-current-entry {
  padding: 0px 10px;
}

icon-current-entry {
  margin: 0px 10px;
  padding: 5px 8px;
  size: 1.4em;
  border: 1px;
  border-radius: 10px;
  background-color: @surface;
  border-color: @surface;
}

mainbox {
  border: 0px;
  padding: 3px;
  spacing: 1px;
  children: [ inputbar, listview];
  border-radius: 1.2em;
}

window {
  border: 2px;
  border-radius: 1.2em;
  border-color: @border-color;
  background-color: @tag-background;
  width: 44%;
}

listview {
  border: 1px;
  border-color: @border;
  background-color: @background;
  border-radius: 1em;

  padding: 10px;
  lines: 6;
  scrollbar: false;
  spacing: 4px;
  columns:          1;
  fixed-height:     false;
}

element {
  padding: 10px 12px;
  background-color: transparent;
  children: [element-icon, element-text];
  vertical-align:   0.5;
}

element-icon {
  size: 1.4em;
}

element-text {
  font: "AdwaitaSans 9";
  text-color: inherit;
  vertical-align: 0.5;
  margin: 0px 0px 0px 10px;
}

element normal.normal {
  text-color: @text-dim;
}

element alternate.normal {
  background-color: transparent;
  text-color: @text-dim;
}

element selected.normal,
element selected.active,
element selected.urgent {
  text-color: @text-color;
  border: 2px;
  border-radius: 0.6em;
  background-color: @selected;
  border-color: @outline;
}

element normal.active,
element alternate.active {
  background-color: @active-bg;
  border-color:     transparent;
  text-color: @text-color;
}

element normal.urgent,
element alternate.urgent {
  background-color: @error-bg;
  border-color:     transparent;
  text-color: @text-color;
}

error-message {
  background-color: @error-bg;
  border:           1px;
  border-color:     @error-border;
  border-radius:    10px;
  padding:          10px;
  text-color:       @text-dim;
}

message {
  border: 1px;
  border-color: @outline;
  background-color: @background;
  border-radius:    10px;
  padding:          10px;
  margin:           0px 10px;
}

textbox {
  text-color:       @text-dim;
  background-color: transparent;
}

/* vim:ft=css */
