spawn-sh-at-startup "waybar -c ~/.config/waybar/leftBar.jsonc -s ~/.config/waybar/left_bar.css"

spawn-sh-at-startup "kitty --single-instance --start-as=hidden"

spawn-sh-at-startup "mako"

spawn-sh-at-startup "wlsunset -S 07:00 -s 22:00 -t 3500 -T 6500 -d 1800"

spawn-sh-at-startup "awww-daemon & set_wallpaper.sh"
