prefer-no-csd

cursor {
  xcursor-theme "material_light_cursors"

  hide-when-typing
  hide-after-inactive-ms 1000
}

environment {
    DISPLAY ":0"
	QT_QPA_PLATFORMTHEME "qt6ct"
	GTK_THEME "Adwaita:dark"
	ADW_DISABLE_PORTAL "1"
}

hotkey-overlay {
  skip-at-startup
}

xwayland-satellite {
    off
}

overview {
    zoom 1
    backdrop-color "transparent"

    workspace-shadow {
        off
    }
}
output "eDP-1" {
  scale 1.1
    variable-refresh-rate on-demand=true
    focus-at-startup
}

switch-events {
   lid-close { spawn "hyprlock" "-q"; }
}
