animations {

  workspace-switch {
	spring damping-ratio=0.8 stiffness=523 epsilon=0.0001
    }

  horizontal-view-movement {
	spring damping-ratio=0.65 stiffness=423 epsilon=0.0001
    }
  window-movement {
	spring damping-ratio=0.65 stiffness=300 epsilon=0.0001
    }


  window-resize {
	spring damping-ratio=0.65 stiffness=423 epsilon=0.0001
    }

  config-notification-open-close {
	spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }

  screenshot-ui-open {
	duration-ms 200
	curve "ease-out-quad"
    }
  overview-open-close {
	spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }

  window-close {
	duration-ms 140
	curve "cubic-bezier" 0.7 0.0 0.3 1.0
    }

  window-open {
	spring damping-ratio=0.65 stiffness=423 epsilon=0.0001
    }
}

