* {
  background:       {{background}}BF;
  tag-background:   {{background}}80;
  foreground:       {{foreground}};
  text-color:       {{foreground}};
  border-color:     {{color4}}80;
  arg-bar:          {{color2}};
  tag-color:        {{color3}};
  selected:         {{color4}}4D;
  warning:          {{color5}};
  success:          {{color6}};

  border:           {{color8}}40;
  text-dim:         {{foreground}}B3;
  text-faint:       {{foreground}}66;
  text-muted:       {{foreground}}99;
  text-border:      {{color11}};
  arg-bg:           {{color12}};
  arg-border:       {{color13}};
}
