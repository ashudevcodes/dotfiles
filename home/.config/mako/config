include=~/.config/mako/colors

max-history=20
sort=-time
icon-path=/home/nemo/.local/share/icons/Yaru
#background-color=#11121dB3
#text-color=#f5f5f7FF
#border-color=#ffffff39

border-size=1
border-radius=18

padding=12,0,12
margin=0

#progress-color=over #ffffff40

anchor=top-right
layer=overlay

font=SF Pro Rounded 10

icons=1
max-icon-size=48
icon-border-radius=10

markup=1

format=<b>%a</b>\n"%s" - <b>%b</b>
default-timeout=5000

group-by=app-icon
max-visible=4
outer-margin=20
[urgency=critical]
#border-color=#ff5c5cAA
#text-color=#ff9494FF

default-timeout=0
border-size=2

[urgency=low]

#background-color=#11121d8C
#border-color=#ffffff1F

default-timeout=3000

[app-name=osd]
anchor=top-center
text-alignment=center
history=0
actions=0
width=220
margin=0
border-size=2
border-radius=17

#background-color=#00000060
#border-color=#ffffff10

icons=0
max-icon-size=64
default-timeout=1000
ignore-timeout=1
group-by=app-name
format=

[app-name=osd grouped]
invisible=1

[app-name=osd group-index=0]
invisible=0

on-button-left=invoke-default-action
on-button-right=dismiss
on-touch=dismiss
